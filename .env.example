# Backend runtime configuration. Copy to .env only when your process manager or
# hosting platform loads dotenv-style files; the Node server reads these values
# from its environment.
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000

# Comma-separated origins allowed to make cross-origin browser requests.
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOW_NULL_ORIGIN=false

# Mobile WebSocket reliability tuning.
WS_HEARTBEAT_INTERVAL_MS=4000
WS_MAX_MISSED_HEARTBEATS=3
WS_DISCONNECT_GRACE_MS=60000
